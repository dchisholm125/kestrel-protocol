# Kestrel Protocol public repo environment example
# Copy to .env and fill in your own values locally.

# --- Network / program ---
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_PROGRAM_ID=3TaXEUn24hw4SncGP9aFskwSqsbhaZod14QEX2akLFxg
SOL_PRICE_USD=150

# --- Authority / operator wallet ---
# JSON array secret key for the devnet authority wallet used to initialize the vault,
# issue operational transactions, and run devnet tests.
DEVNET_PRIVATE_KEY=[]
PUBLIC_WALLET_KEY=

# --- Buyer wallets for devnet tests ---
# Primary buyer used in devnet tests.
DEVNET_BUYER_PRIVATE_KEY=[]
DEVNET_BUYER_WALLET=

# Optional second buyer for two-party or sequential test scenarios.
DEVNET_BUYER2_PRIVATE_KEY=[]
DEVNET_BUYER2_WALLET=

# --- Optional mainnet placeholders (do not populate casually) ---
MAINNET_RPC_URL=
MAINNET_PROGRAM_ID=
MAINNET_PRIVATE_KEY=[]
