{
  "name": "@kestrel-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Kestrel Protocol execution protection",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "example:swap": "tsx examples/protected-swap.ts",
    "test:quick:devnet": "tsx tests/devnetTest.ts",
    "test:full:devnet": "tsx tests/devnetRealTest.ts"
  },
  "keywords": [
    "solana",
    "kestrel",
    "slippage",
    "insurance",
    "execution"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@jup-ag/core": "^4.0.0-beta.21",
    "@solana/buffer-layout": "^4.0.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.1",
    "dotenv": "^16.4.7",
    "jsbi": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@jup-ag/common": {
      "@solana/web3.js": "^1.98.4"
    }
  },
  "license": "MIT"
}
