{
  "name": "@kestrel-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Kestrel Protocol execution protection",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "solana",
    "kestrel",
    "slippage",
    "insurance",
    "execution"
  ],
  "license": "MIT"
}
