{
  "name": "@kestrel-protocol/sdk",
  "version": "0.1.7",
  "description": "Public TypeScript SDK for Kestrel Protocol slippage insurance on Solana",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "examples/"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solana",
    "kestrel",
    "slippage",
    "insurance",
    "jupiter",
    "defi"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.87.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.0.0"
  },
  "license": "MIT"
}
